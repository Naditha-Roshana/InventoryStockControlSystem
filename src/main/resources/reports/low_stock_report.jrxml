<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="low_stock_report" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<queryString>
		<![CDATA[SELECT p.code, p.name, s.name AS supplier, p.quantity, p.reorder_level, CAST(p.reorder_level - p.quantity AS SIGNED) AS shortage FROM products p JOIN suppliers s ON p.supplier_id = s.id WHERE p.quantity <= p.reorder_level ORDER BY shortage DESC]]>
	</queryString>
	<field name="code" class="java.lang.String"/>
	<field name="name" class="java.lang.String"/>
	<field name="supplier" class="java.lang.String"/>
	<field name="quantity" class="java.lang.Integer"/>
	<field name="reorder_level" class="java.lang.Integer"/>
	<field name="shortage" class="java.lang.Long"/>
	<title>
		<band height="70">
			<staticText>
				<reportElement x="0" y="5" width="555" height="30"/>
				<textElement textAlignment="Center"><font size="18" isBold="true"/></textElement>
				<text><![CDATA[Low Stock Report]]></text>
			</staticText>
			<textField>
				<reportElement x="0" y="40" width="555" height="20"/>
				<textElement textAlignment="Center"/>
				<textFieldExpression><![CDATA["Inventory and Stock Control System  |  Generated: " + new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm").format(new java.util.Date())]]></textFieldExpression>
			</textField>
		</band>
	</title>
	<columnHeader>
		<band height="26">
			<staticText>
				<reportElement mode="Opaque" backcolor="#D9D9D9" x="0" y="0" width="70" height="24"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"><font isBold="true"/></textElement>
				<text><![CDATA[Code]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" backcolor="#D9D9D9" x="70" y="0" width="170" height="24"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"><font isBold="true"/></textElement>
				<text><![CDATA[Product]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" backcolor="#D9D9D9" x="240" y="0" width="130" height="24"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"><font isBold="true"/></textElement>
				<text><![CDATA[Supplier]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" backcolor="#D9D9D9" x="370" y="0" width="55" height="24"/>
				<textElement textAlignment="Right" verticalAlignment="Middle"><font isBold="true"/></textElement>
				<text><![CDATA[Qty]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" backcolor="#D9D9D9" x="425" y="0" width="60" height="24"/>
				<textElement textAlignment="Right" verticalAlignment="Middle"><font isBold="true"/></textElement>
				<text><![CDATA[Reorder]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" backcolor="#D9D9D9" x="485" y="0" width="70" height="24"/>
				<textElement textAlignment="Right" verticalAlignment="Middle"><font isBold="true"/></textElement>
				<text><![CDATA[Short]]></text>
			</staticText>
		</band>
	</columnHeader>
	<detail>
		<band height="22">
			<textField isBlankWhenNull="true">
				<reportElement x="0" y="0" width="70" height="20"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA[$F{code}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="70" y="0" width="170" height="20"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA[$F{name}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="240" y="0" width="130" height="20"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA[$F{supplier}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="370" y="0" width="55" height="20"/>
				<textElement textAlignment="Right" verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA[$F{quantity}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="425" y="0" width="60" height="20"/>
				<textElement textAlignment="Right" verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA[$F{reorder_level}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="485" y="0" width="70" height="20"/>
				<textElement textAlignment="Right" verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA[$F{shortage}]]></textFieldExpression>
			</textField>
			<line>
				<reportElement x="0" y="21" width="555" height="1" forecolor="#BBBBBB"/>
			</line>
		</band>
	</detail>
	<pageFooter>
		<band height="25">
			<textField>
				<reportElement x="0" y="3" width="555" height="18"/>
				<textElement textAlignment="Center"/>
				<textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression>
			</textField>
		</band>
	</pageFooter>
</jasperReport>
