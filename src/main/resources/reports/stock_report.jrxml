<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="stock_report" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<queryString>
		<![CDATA[SELECT p.code, p.name, c.name AS category, p.quantity, p.reorder_level, p.unit_price FROM products p JOIN categories c ON p.category_id = c.id ORDER BY p.name]]>
	</queryString>
	<field name="code" class="java.lang.String"/>
	<field name="name" class="java.lang.String"/>
	<field name="category" class="java.lang.String"/>
	<field name="quantity" class="java.lang.Integer"/>
	<field name="reorder_level" class="java.lang.Integer"/>
	<field name="unit_price" class="java.math.BigDecimal"/>
	<title>
		<band height="70">
			<staticText>
				<reportElement x="0" y="5" width="555" height="30"/>
				<textElement textAlignment="Center"><font size="18" isBold="true"/></textElement>
				<text><![CDATA[Current Stock Report]]></text>
			</staticText>
			<textField>
				<reportElement x="0" y="40" width="555" height="20"/>
				<textElement textAlignment="Center"/>
				<textFieldExpression><![CDATA["Inventory and Stock Control System  |  Generated: " + new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm").format(new java.util.Date())]]></textFieldExpression>
			</textField>
		</band>
	</title>
	<columnHeader>
		<band height="26">
			<staticText>
				<reportElement mode="Opaque" backcolor="#D9D9D9" x="0" y="0" width="70" height="24"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"><font isBold="true"/></textElement>
				<text><![CDATA[Code]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" backcolor="#D9D9D9" x="70" y="0" width="170" height="24"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"><font isBold="true"/></textElement>
				<text><![CDATA[Product]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" backcolor="#D9D9D9" x="240" y="0" width="110" height="24"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"><font isBold="true"/></textElement>
				<text><![CDATA[Category]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" backcolor="#D9D9D9" x="350" y="0" width="55" height="24"/>
				<textElement textAlignment="Right" verticalAlignment="Middle"><font isBold="true"/></textElement>
				<text><![CDATA[Qty]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" backcolor="#D9D9D9" x="405" y="0" width="55" height="24"/>
				<textElement textAlignment="Right" verticalAlignment="Middle"><font isBold="true"/></textElement>
				<text><![CDATA[Reorder]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" backcolor="#D9D9D9" x="460" y="0" width="95" height="24"/>
				<textElement textAlignment="Right" verticalAlignment="Middle"><font isBold="true"/></textElement>
				<text><![CDATA[Price]]></text>
			</staticText>
		</band>
	</columnHeader>
	<detail>
		<band height="22">
			<textField isBlankWhenNull="true">
				<reportElement x="0" y="0" width="70" height="20"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA[$F{code}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="70" y="0" width="170" height="20"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA[$F{name}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="240" y="0" width="110" height="20"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA[$F{category}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="350" y="0" width="55" height="20"/>
				<textElement textAlignment="Right" verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA[$F{quantity}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="405" y="0" width="55" height="20"/>
				<textElement textAlignment="Right" verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA[$F{reorder_level}]]></textFieldExpression>
			</textField>
			<textField pattern="#,##0.00" isBlankWhenNull="true">
				<reportElement x="460" y="0" width="95" height="20"/>
				<textElement textAlignment="Right" verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA[$F{unit_price}]]></textFieldExpression>
			</textField>
			<line>
				<reportElement x="0" y="21" width="555" height="1" forecolor="#BBBBBB"/>
			</line>
		</band>
	</detail>
	<pageFooter>
		<band height="25">
			<textField>
				<reportElement x="0" y="3" width="555" height="18"/>
				<textElement textAlignment="Center"/>
				<textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression>
			</textField>
		</band>
	</pageFooter>
</jasperReport>
